<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
    </style>
    <!-- kleine Hinweis-Pille auf dunklem Glas -->
    <style name="Pille">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/glas_pille</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>
    <!-- runder Glas-Knopf 52 dp -->
    <style name="RundKnopf">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/glas_rund</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
    </style>
    <!-- Eintrag im Mehr-Menü (Pille, 48 dp hoch) -->
    <style name="MenuePille">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:background">@drawable/glas_pille</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/text</item>
    </style>
    <!-- Knopf im Info-Blatt -->
    <style name="BlattKnopf">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/glas_pille</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>
    <!-- Bearbeiten-Bildschirm (ab 0.4) -->
    <style name="EditZeile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <style name="EditLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="EditWert">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_neben</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="EditRegler">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:progressTint">#FFFFFFFF</item>
        <item name="android:progressBackgroundTint">#59FFFFFF</item>
        <item name="android:thumbTint">#FFFFFFFF</item>
        <item name="android:splitTrack">false</item>
    </style>
    <style name="EditSchalter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:thumbTint">@color/schalter_daumen</item>
        <item name="android:trackTint">@color/schalter_spur</item>
    </style>
    <!-- Wahl-Pille (z. B. Frei / Original / 1:1); gewählt = weiß, wird im Code umgeschaltet -->
    <style name="EditWahl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/glas_pille</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="EditKnopf">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/glas_pille</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/text</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <style name="EditReset">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/glas_pille</item>
        <item name="android:textColor">@color/text_neben</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="EditTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">10.5sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
