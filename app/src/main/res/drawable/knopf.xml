<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#40FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#33FFFFFF" /><corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#1FFFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
