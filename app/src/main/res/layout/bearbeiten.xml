<?xml version="1.0" encoding="utf-8"?>
<!-- Zeichenhilfe AR 0.4 – Bildschirm „Foto bearbeiten“ (Design M1). Wird in activity_main eingebunden.
     Hoch: Vorschau oben, Werkzeuge darunter. Quer: Werkzeuge rechts (EditScreen.applyLayout). Autor: Benjamin Dormoros -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/edit"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0C"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kopfzeile -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <ImageButton
                android:id="@+id/editBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/beschr_zurueck"
                android:src="@drawable/ic_zurueck"
                android:tint="@color/text" />
            <TextView
                android:id="@+id/editTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="60dp"
                android:text="@string/bearbeiten_titel"
                android:textColor="@color/text"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/editResetAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/bearbeiten_alles_zurueck"
                android:textColor="@color/text_neben"
                android:textSize="13sp" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/editBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <de.benni.zeichenhilfe.EditPreviewView
                android:id="@+id/editPreview"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/editSide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Werkzeugreihe -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/tabCrop" style="@style/EditTab" android:drawableTop="@drawable/ic_schnitt" android:text="@string/werkzeug_zuschneiden" />
                    <TextView android:id="@+id/tabRotate" style="@style/EditTab" android:drawableTop="@drawable/ic_drehen" android:text="@string/werkzeug_drehen" />
                    <TextView android:id="@+id/tabTone" style="@style/EditTab" android:drawableTop="@drawable/ic_ton" android:text="@string/werkzeug_ton" />
                    <TextView android:id="@+id/tabLines" style="@style/EditTab" android:drawableTop="@drawable/ic_linien" android:text="@string/werkzeug_linien" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/editPanelScroll"
                    android:layout_width="match_parent"
                    android:layout_height="216dp"
                    android:fadeScrollbars="true">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="20dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp">

                        <!-- Zuschneiden -->
                        <LinearLayout android:id="@+id/panelCrop" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView style="@style/EditWert" android:text="@string/bearbeiten_seitenverhaeltnis" />
                            <LinearLayout style="@style/EditZeile">
                                <TextView android:id="@+id/cropFree" style="@style/EditWahl" android:text="@string/bearbeiten_frei" />
                                <TextView android:id="@+id/cropOrig" style="@style/EditWahl" android:text="@string/bearbeiten_original" />
                                <TextView android:id="@+id/cropSquare" style="@style/EditWahl" android:text="@string/bearbeiten_quadrat" />
                            </LinearLayout>
                            <TextView style="@style/EditWert" android:layout_marginTop="10dp" android:text="@string/bearbeiten_zuschnitt_hinweis" />
                            <TextView android:id="@+id/cropReset" style="@style/EditReset" android:text="@string/bearbeiten_zuruecksetzen" />
                        </LinearLayout>

                        <!-- Drehen -->
                        <LinearLayout android:id="@+id/panelRotate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout style="@style/EditZeile">
                                <TextView android:id="@+id/rotLeft" style="@style/EditKnopf" android:drawableStart="@drawable/ic_links90" android:text="@string/bearbeiten_links90" />
                                <TextView android:id="@+id/rotRight" style="@style/EditKnopf" android:drawableStart="@drawable/ic_rechts90" android:text="@string/bearbeiten_rechts90" />
                                <TextView android:id="@+id/rotFlip" style="@style/EditKnopf" android:drawableStart="@drawable/ic_spiegeln" android:text="@string/bearbeiten_spiegeln" />
                            </LinearLayout>
                            <LinearLayout style="@style/EditZeile" android:layout_marginTop="12dp">
                                <TextView style="@style/EditLabel" android:text="@string/bearbeiten_feindrehung" />
                                <TextView android:id="@+id/fineVal" style="@style/EditWert" android:text="0,0°" />
                            </LinearLayout>
                            <SeekBar android:id="@+id/fineSeek" style="@style/EditRegler" android:max="900" android:progress="450" />
                            <TextView android:id="@+id/rotReset" style="@style/EditReset" android:text="@string/bearbeiten_zuruecksetzen" />
                        </LinearLayout>

                        <!-- Ton -->
                        <LinearLayout android:id="@+id/panelTone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <LinearLayout style="@style/EditZeile">
                                <TextView style="@style/EditLabel" android:text="@string/bearbeiten_helligkeit" />
                                <TextView android:id="@+id/brightVal" style="@style/EditWert" android:text="0" />
                            </LinearLayout>
                            <SeekBar android:id="@+id/brightSeek" style="@style/EditRegler" android:max="200" android:progress="100" />
                            <LinearLayout style="@style/EditZeile">
                                <TextView style="@style/EditLabel" android:text="@string/bearbeiten_kontrast" />
                                <TextView android:id="@+id/contrastVal" style="@style/EditWert" android:text="0" />
                            </LinearLayout>
                            <SeekBar android:id="@+id/contrastSeek" style="@style/EditRegler" android:max="200" android:progress="100" />
                            <Switch android:id="@+id/graySwitch" style="@style/EditSchalter" android:text="@string/bearbeiten_graustufen" />
                            <TextView android:id="@+id/toneReset" style="@style/EditReset" android:text="@string/bearbeiten_zuruecksetzen" />
                        </LinearLayout>

                        <!-- Linien -->
                        <LinearLayout android:id="@+id/panelLines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <Switch android:id="@+id/linesSwitch" style="@style/EditSchalter" android:text="@string/bearbeiten_linienbild" />
                            <LinearLayout style="@style/EditZeile">
                                <TextView style="@style/EditLabel" android:text="@string/bearbeiten_empfindlichkeit" />
                                <TextView android:id="@+id/sensVal" style="@style/EditWert" android:text="50" />
                            </LinearLayout>
                            <SeekBar android:id="@+id/sensSeek" style="@style/EditRegler" android:max="100" android:progress="50" />
                            <TextView style="@style/EditWert" android:text="@string/bearbeiten_linienstaerke" />
                            <LinearLayout style="@style/EditZeile">
                                <TextView android:id="@+id/widthFine" style="@style/EditWahl" android:text="@string/bearbeiten_fein" />
                                <TextView android:id="@+id/widthMid" style="@style/EditWahl" android:text="@string/bearbeiten_mittel" />
                                <TextView android:id="@+id/widthBold" style="@style/EditWahl" android:text="@string/bearbeiten_kraeftig" />
                            </LinearLayout>
                            <Switch android:id="@+id/transpSwitch" style="@style/EditSchalter" android:layout_marginTop="6dp" android:text="@string/bearbeiten_durchsichtig" />
                            <TextView android:id="@+id/linesReset" style="@style/EditReset" android:text="@string/bearbeiten_zuruecksetzen" />
                        </LinearLayout>
                    </FrameLayout>
                </ScrollView>

                <TextView
                    android:id="@+id/editApply"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/weiss_pille"
                    android:gravity="center"
                    android:text="@string/bearbeiten_auflegen"
                    android:textColor="@color/tinte"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hinweis während der Berechnung -->
    <TextView
        android:id="@+id/editBusy"
        style="@style/Pille"
        android:layout_gravity="center"
        android:text="@string/bearbeiten_vorbereiten"
        android:visibility="gone" />
</FrameLayout>
